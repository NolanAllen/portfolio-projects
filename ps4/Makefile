CC = g++
CFLAGS = --std=c++14 -Wall -Werror -pedantic
LIB = -lsfml-graphics -lsfml-audio -lsfml-window -lsfml-system

all: Sokoban lint

%.o: %.cpp $(DEPS)
	$(CC) $(CFLAGS) -c $<

Sokoban: main.o Sokoban.o
	$(CC) $(CFLAGS) -o $@ $^ $(LIB)

lint:
	cpplint --filter=-runtime/references,-build/c++11 --root=. *.cpp *.hpp

clean:
	rm *.o Sokoban
